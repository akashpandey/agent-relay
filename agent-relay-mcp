#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
export NODE_NO_WARNINGS="${NODE_NO_WARNINGS:-1}"
node_bin="${NODE_BIN:-}"
if [ -z "$node_bin" ]; then
  if command -v node >/dev/null 2>&1; then
    node_bin="$(command -v node)"
  elif [ -x "/home/akey/.nvm/versions/node/v24.14.0/bin/node" ]; then
    node_bin="/home/akey/.nvm/versions/node/v24.14.0/bin/node"
  else
    echo "agent-relay-mcp: node not found" >&2
    exit 127
  fi
fi
exec "$node_bin" "$repo_dir/scripts/mcp-server.mjs" "$@"
