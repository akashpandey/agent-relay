#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
export NODE_NO_WARNINGS="${NODE_NO_WARNINGS:-1}"
node_bin="${NODE_BIN:-}"
if [ -z "$node_bin" ]; then
  if command -v node >/dev/null 2>&1; then
    node_bin="$(command -v node)"
  else
    # Auto-discover the latest NVM-managed Node.js installation
    nvm_dir="${NVM_DIR:-$HOME/.nvm}"
    if [ -d "$nvm_dir/versions/node" ]; then
      latest_node="$(ls -v "$nvm_dir/versions/node/" 2>/dev/null | tail -1)"
      if [ -n "$latest_node" ] && [ -x "$nvm_dir/versions/node/$latest_node/bin/node" ]; then
        node_bin="$nvm_dir/versions/node/$latest_node/bin/node"
      fi
    fi
  fi
fi
if [ -z "$node_bin" ]; then
  echo "agent-relay-mcp: node not found — install Node.js or set NODE_BIN" >&2
  exit 127
fi
exec "$node_bin" "$repo_dir/scripts/mcp-server.mjs" "$@"
