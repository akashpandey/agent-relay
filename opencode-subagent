#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

workspace="$(pwd -P)"

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

if [ "${1:-}" = "--models" ]; then
  if [ "${2:-}" = "--refresh" ] && [ "$#" -eq 2 ]; then
    "$HOME/.opencode/bin/opencode" models --refresh >/dev/null
  elif [ "$#" -ne 1 ]; then
    echo "Usage: opencode-subagent --models [--refresh]" >&2
    exit 2
  fi

  # The wrapper deliberately supports only the providers documented below.
  # Do not leak every locally configured OpenCode provider to calling harnesses.
  for provider in opencode-go openai zai-coding-plan; do
    "$HOME/.opencode/bin/opencode" models "$provider"
  done
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  opencode-subagent "task"
  printf '%s\n' "task" | opencode-subagent
  opencode-subagent --models [--refresh]

Environment:
  OPENCODE_MODEL    Model in provider/model format or family alias:
                    - 'openai/latest' / 'openai/sol' / 'gpt-sol': newest OpenAI GPT Sol (e.g. gpt-5.6-sol)
                    - 'openai/terra' / 'openai/luna' / 'openai/mini': newest specific OpenAI tier
                    - 'zai/latest' / 'glm/latest' / 'glm': newest Z.AI GLM (e.g. glm-5.3)
                    - 'zai/flash' / 'glm/flash': newest Z.AI GLM Flash
                    - 'opencode-go/qwen-latest': newest Qwen Max
                    - 'opencode-go/deepseek-latest': newest DeepSeek Pro
  OPENCODE_VARIANT  Optional model variant, e.g. high.
  OPENCODE_AGENT    Optional opencode agent name.
  OPENCODE_TIMEOUT  Optional timeout in seconds. Default: 7200.
  OPENCODE_LOGS     Print opencode logs to stderr. Default: 1.
  SUBAGENT_SESSION  Resume this provider's existing session ID.
  SUBAGENT_LOG_DIR  Where wrapper run logs are written. Default: ~/local-subagents/logs.

Every run's combined stdout+stderr (including opencode's own --print-logs
stream) is teed to a timestamped file under SUBAGENT_LOG_DIR (printed in the
startup banner) so a backgrounded run can be tailed live instead of waiting
for the final result.

Examples:
  OPENCODE_MODEL='openai/latest' opencode-subagent "Fix the bug"
  OPENCODE_MODEL='glm/latest' opencode-subagent "Review this repo"
  OPENCODE_MODEL='openai/gpt-5.6-sol' opencode-subagent "Implement TASK.md"

Supported model providers: opencode-go, openai, zai-coding-plan.
Use `opencode-subagent --models` to list the currently available models, or
`opencode-subagent --models --refresh` to refresh OpenCode's cache first.
EOF
  exit 0
fi

resume_session="${SUBAGENT_SESSION:-}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

export CI="${CI:-1}"
export npm_config_yes="${npm_config_yes:-true}"
export npm_config_fund="${npm_config_fund:-false}"
export npm_config_audit="${npm_config_audit:-false}"
export DEBIAN_FRONTEND="${DEBIAN_FRONTEND:-noninteractive}"
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"
export PAGER="${PAGER:-cat}"
export GIT_PAGER="${GIT_PAGER:-cat}"
export SYSTEMD_PAGER="${SYSTEMD_PAGER:-cat}"

prompt="You are running as a non-interactive coding subagent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Run all commands in non-interactive batch mode (e.g. use 'npx -y', avoid interactive stdin/prompts).
- After editing, summarize changed files and verification commands.
- End your final response with a JSON object containing: outcome (done|partial|blocked|failed), summary, changedFiles, verification, blockers, incomplete, nextSteps. The JSON object must be the last non-whitespace content. Do not write anything after it. Each verification item must be an object with command, status (passed|failed|skipped), and optional reason.
- Use outcome=done only when the requested task is complete and verification passed or was explicitly unnecessary.

Task:
$user_prompt"

timeout_seconds="${OPENCODE_TIMEOUT:-7200}"
log_flag="${OPENCODE_LOGS:-1}"

resolve_opencode_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  # Automatic reroute for token-heavy routes
  case "$raw_model" in
    opencode-go/glm-5.3)
      echo "opencode-subagent: rerouting opencode-go/glm-5.3 -> zai-coding-plan/glm-5.3 (token-heavy route)" >&2
      echo "zai-coding-plan/glm-5.3"
      return 0
      ;;
    opencode-go/glm-5.2)
      echo "opencode-subagent: rerouting opencode-go/glm-5.2 -> zai-coding-plan/glm-5.2 (token-heavy route)" >&2
      echo "zai-coding-plan/glm-5.2"
      return 0
      ;;
  esac

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    openai/latest|openai/gpt-latest|openai/sol|gpt-sol|openai/gpt|latest)
      resolved="$("$HOME/.opencode/bin/opencode" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-sol$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-sol"
      ;;
    openai/terra|gpt-terra)
      resolved="$("$HOME/.opencode/bin/opencode" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-terra$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-terra"
      ;;
    openai/luna|gpt-luna)
      resolved="$("$HOME/.opencode/bin/opencode" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-luna$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-luna"
      ;;
    openai/mini|openai/gpt-mini|gpt-mini)
      resolved="$("$HOME/.opencode/bin/opencode" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-mini$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.4-mini"
      ;;
    zai/latest|zai-coding-plan/latest|glm/latest|glm|zai/glm|zai-coding-plan/glm)
      resolved="$("$HOME/.opencode/bin/opencode" models zai-coding-plan 2>/dev/null | grep -E '^zai-coding-plan/glm-[0-9.]+$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "zai-coding-plan/glm-5.3"
      ;;
    zai/flash|zai-coding-plan/flash|glm/flash|glm-flash)
      resolved="$("$HOME/.opencode/bin/opencode" models zai-coding-plan 2>/dev/null | grep -E '^zai-coding-plan/glm-[0-9.]+-flash$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "zai-coding-plan/glm-5.3-flash"
      ;;
    opencode-go/qwen-latest|qwen-latest|qwen)
      resolved="$("$HOME/.opencode/bin/opencode" models opencode-go 2>/dev/null | grep -E '^opencode-go/qwen[0-9.]+-max$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "opencode-go/qwen3.8-max"
      ;;
    opencode-go/deepseek-latest|deepseek-latest|deepseek)
      resolved="$("$HOME/.opencode/bin/opencode" models opencode-go 2>/dev/null | grep -E '^opencode-go/deepseek-v[0-9.]+-pro$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "opencode-go/deepseek-v4-pro"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

if [ -n "${OPENCODE_MODEL:-}" ]; then
  resolved_opencode_model="$(resolve_opencode_model "$OPENCODE_MODEL")"
  if [ "$resolved_opencode_model" != "$OPENCODE_MODEL" ]; then
    echo "opencode-subagent: resolved alias '$OPENCODE_MODEL' -> '$resolved_opencode_model'" >&2
    OPENCODE_MODEL="$resolved_opencode_model"
  fi
fi

log_dir="${SUBAGENT_LOG_DIR:-$repo_dir/logs}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-opencode-$$.log"
done_file="$log_file.done"
unit="local-subagent-opencode-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
trap 'stop_subagent' EXIT
trap 'stop_subagent; exit 143' HUP INT TERM

cd "$workspace"

set -- run --dir "$workspace" --auto

if [ "${OPENCODE_MODEL:-}" ]; then
  set -- "$@" --model "$OPENCODE_MODEL"
fi

if [ "${OPENCODE_VARIANT:-}" ]; then
  set -- "$@" --variant "$OPENCODE_VARIANT"
fi

if [ "${OPENCODE_AGENT:-}" ]; then
  set -- "$@" --agent "$OPENCODE_AGENT"
fi

if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- "$@" --continue
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- "$@" --session "$resume_session"
fi

if [ "$log_flag" = "1" ]; then
  set -- "$@" --print-logs
fi

set -- "$@" "$prompt"

if [ "$log_flag" = "1" ]; then
  echo "opencode-subagent: workspace=$workspace model=${OPENCODE_MODEL:-default} variant=${OPENCODE_VARIANT:-default} agent=${OPENCODE_AGENT:-default} session=${resume_session:-new} timeout=${timeout_seconds}s run_log=$log_file" >&2
fi

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"

printf 'subagent: provider=opencode workspace=%s model=%s session=%s\nTask:\n%s\n\n---\n\n' \
  "$workspace" "${OPENCODE_MODEL:-default}" "${resume_session:-new}" "$user_prompt" > "$log_file"

# Register run start in SQLite database immediately
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" start "$(basename "$log_file")" "$$" "opencode" "${OPENCODE_MODEL:-default}" "$workspace" "${resume_session:-new}" "$user_prompt" >/dev/null 2>&1 || true
fi

if [ "$use_systemd" -eq 1 ]; then
  systemd-run --user --pipe --working-directory="$workspace" --setenv=PATH="$PATH" --wait --collect --quiet --unit="$unit" --property=KillMode=control-group --property=RuntimeMaxSec="${timeout_seconds}s" "$HOME/.opencode/bin/opencode" "$@" >>"$log_file" 2>&1 &
elif [ "$timeout_seconds" -gt 0 ] 2>/dev/null && command -v timeout >/dev/null 2>&1; then
  setsid timeout --foreground "${timeout_seconds}s" "$HOME/.opencode/bin/opencode" "$@" >>"$log_file" 2>&1 &
else
  setsid "$HOME/.opencode/bin/opencode" "$@" >>"$log_file" 2>&1 &
fi
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# Background watchdog: reap hanging runtime if task completed but lingering event-loop handles prevent exit
(
  while kill -0 "$cmd_pid" 2>/dev/null; do
    sleep 2
    if grep -qE 'message="disposing instance"|message="exiting loop"' "$log_file" 2>/dev/null || \
       awk '/^---$/{f=1; next} f' "$log_file" 2>/dev/null | grep -qE '(\\"|")outcome(\\"|"):[[:space:]]*(\\"|")(done|partial|blocked|failed)'; then
      grace=6
      while [ "$grace" -gt 0 ] && kill -0 "$cmd_pid" 2>/dev/null; do
        sleep 1
        grace=$((grace - 1))
      done
      if kill -0 "$cmd_pid" 2>/dev/null; then
        touch "${log_file}.reaped"
        if [ "$use_systemd" -eq 1 ]; then
          systemctl --user stop "$unit" >/dev/null 2>&1 || true
        elif command -v pkill >/dev/null 2>&1; then
          pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
          sleep 1
          pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
        fi
      fi
      break
    fi
  done
) &
watchdog_pid=$!

# ponytail: `wait` returns the waited-on process's exit status, which is
# routinely nonzero (timeouts, model errors). Under `set -e` a bare `wait`
# call there aborts the script on the spot — every cleanup line below it
# would silently never run. set +e/-e brackets just this one call so the
# real status still gets captured deliberately, not lost to errexit.
set +e
wait "$cmd_pid"
status=$?
set -e

kill "$watchdog_pid" >/dev/null 2>&1 || true
wait "$watchdog_pid" 2>/dev/null || true
kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if [ -f "${log_file}.reaped" ]; then
  rm -f "${log_file}.reaped"
  if [ "$status" -ne 0 ]; then
    if [ "$log_flag" = "1" ]; then
      echo "opencode-subagent: process reaped after task completion (lingering event-loop handles)" >&2
    fi
    status=0
  fi
fi

if [ "$use_systemd" -eq 1 ]; then
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
elif command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# Clean up orphaned processes in the workspace (only in non-systemd fallback mode)
if [ "$use_systemd" -eq 0 ]; then
  workspace_real="$(cd "$workspace" && pwd -P)"
  after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
  new_pids=""
  for pid in $after_pids; do
    case " $before_pids " in
      *" $pid "*) ;;
      *) new_pids="$new_pids $pid" ;;
    esac
  done

  for sig in TERM KILL; do
    if [ "$sig" = "KILL" ]; then
      sleep 1
    fi
    for pid in $new_pids; do
      [ "$pid" = "$$" ] && continue
      pid_cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
      case "$pid_cmd" in
        *-subagent*|*systemd-run*|*claude*|*codex*|*opencode*|*antigravity*|*agy*)
          continue
          ;;
      esac
      pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
      if [ -z "$pid_cwd" ]; then
        continue
      fi
      case "$pid_cwd" in
        "$workspace_real"|"$workspace_real"/*)
          kill "-$sig" "$pid" >/dev/null 2>&1 || true
          ;;
      esac
    done
  done
fi

# Write completion sentinel file (.done)
done_file="${log_file%.log}.done"
sess_id="$(grep -oE 'session\.id=[^ ]+' "$log_file" 2>/dev/null | head -n 1 | cut -d'=' -f2 || grep -oE '"session_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || echo "${resume_session:-new}")"
cat <<DONE_JSON > "$done_file"
{
  "status": "$([ "$status" -eq 0 ] && echo "completed" || echo "failed")",
  "exitCode": $status,
  "provider": "opencode",
  "workspace": "$workspace",
  "model": "${OPENCODE_MODEL:-default}",
  "sessionId": "$sess_id",
  "logFile": "$log_file",
  "completedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
DONE_JSON

# Automatically ingest subagent session to claude-mem (non-blocking)
if [ -f "$done_file" ] && command -v bun >/dev/null 2>&1; then
  bun "$repo_dir/scripts/ingest-to-claude-mem.js" "$done_file" >/dev/null 2>&1 &
fi

# Register run completion in SQLite database
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" complete "$(basename "$log_file")" "$status" "$sess_id" >/dev/null 2>&1 || true
fi

if [ "$log_flag" = "1" ]; then
  echo "opencode-subagent: finished status=$status ($([ "$status" -eq 0 ] && echo "completed" || echo "failed")) session=$sess_id" >&2
fi

exit "$status"
