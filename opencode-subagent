#!/usr/bin/env sh
set -eu

workspace="$(pwd -P)"

if [ "${1:-}" = "--models" ]; then
  if [ "${2:-}" = "--refresh" ] && [ "$#" -eq 2 ]; then
    "$HOME/.opencode/bin/opencode" models --refresh >/dev/null
  elif [ "$#" -ne 1 ]; then
    echo "Usage: opencode-subagent --models [--refresh]" >&2
    exit 2
  fi

  # The wrapper deliberately supports only the providers documented below.
  # Do not leak every locally configured OpenCode provider to calling harnesses.
  for provider in opencode-go openai zai-coding-plan; do
    "$HOME/.opencode/bin/opencode" models "$provider"
  done
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  opencode-subagent "task"
  printf '%s\n' "task" | opencode-subagent
  opencode-subagent --models [--refresh]

Environment:
  OPENCODE_MODEL    Model in provider/model format.
  OPENCODE_VARIANT  Optional model variant, e.g. high.
  OPENCODE_AGENT    Optional opencode agent name.
  OPENCODE_TIMEOUT  Optional timeout in seconds. Default: 7200.
  OPENCODE_LOGS     Print opencode logs to stderr. Default: 1.
  SUBAGENT_SESSION  Resume this provider's existing session ID.
  SUBAGENT_LOG_DIR  Where wrapper run logs are written. Default: ~/local-subagents/logs.

Every run's combined stdout+stderr (including opencode's own --print-logs
stream) is teed to a timestamped file under SUBAGENT_LOG_DIR (printed in the
startup banner) so a backgrounded run can be tailed live instead of waiting
for the final result.

Examples:
  OPENCODE_MODEL='openai/gpt-5.4-mini' opencode-subagent "Fix the bug"
  OPENCODE_MODEL='opencode-go/qwen3.7-plus' opencode-subagent "Review this repo"
  OPENCODE_MODEL='zai-coding-plan/glm-5.2' opencode-subagent "Implement TASK.md"

Supported model providers: opencode-go, openai, zai-coding-plan.
Use `opencode-subagent --models` to list the currently available models, or
`opencode-subagent --models --refresh` to refresh OpenCode's cache first.
EOF
  exit 0
fi

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

export CI="${CI:-1}"
export npm_config_yes="${npm_config_yes:-true}"
export npm_config_fund="${npm_config_fund:-false}"
export npm_config_audit="${npm_config_audit:-false}"
export DEBIAN_FRONTEND="${DEBIAN_FRONTEND:-noninteractive}"
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"
export PAGER="${PAGER:-cat}"
export GIT_PAGER="${GIT_PAGER:-cat}"
export SYSTEMD_PAGER="${SYSTEMD_PAGER:-cat}"

prompt="You are running as a non-interactive coding subagent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Run all commands in non-interactive batch mode (e.g. use 'npx -y', avoid interactive stdin/prompts).
- After editing, summarize changed files and verification commands.

Task:
$user_prompt"

timeout_seconds="${OPENCODE_TIMEOUT:-7200}"
log_flag="${OPENCODE_LOGS:-1}"

# ponytail: opencode-go/glm-5.2 is token-heavy for the same work as the
# zai-coding-plan route — reroute automatically instead of trusting every
# caller to know that. Widen this if other opencode-go models get the same
# recommendation.
if [ "${OPENCODE_MODEL:-}" = "opencode-go/glm-5.2" ]; then
  echo "opencode-subagent: rerouting opencode-go/glm-5.2 -> zai-coding-plan/glm-5.2 (token-heavy route)" >&2
  OPENCODE_MODEL="zai-coding-plan/glm-5.2"
fi

log_dir="${SUBAGENT_LOG_DIR:-$HOME/local-subagents/logs}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-opencode-$$.log"
unit="local-subagent-opencode-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""

stop_subagent() {
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
trap 'stop_subagent' EXIT
trap 'stop_subagent; exit 143' HUP INT TERM

set -- run --dir "$workspace" --auto

if [ "${OPENCODE_MODEL:-}" ]; then
  set -- "$@" --model "$OPENCODE_MODEL"
fi

if [ "${OPENCODE_VARIANT:-}" ]; then
  set -- "$@" --variant "$OPENCODE_VARIANT"
fi

if [ "${OPENCODE_AGENT:-}" ]; then
  set -- "$@" --agent "$OPENCODE_AGENT"
fi

[ -z "${SUBAGENT_SESSION:-}" ] || set -- "$@" --session "$SUBAGENT_SESSION"

if [ "$log_flag" = "1" ]; then
  set -- "$@" --print-logs
fi

echo "opencode-subagent: workspace=$workspace model=${OPENCODE_MODEL:-default} agent=${OPENCODE_AGENT:-default} session=${SUBAGENT_SESSION:-new} timeout=${timeout_seconds}s logs=${log_flag} run_log=$log_file" >&2

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"

printf 'subagent: provider=opencode workspace=%s model=%s session=%s\nTask:\n%s\n\n---\n\n' \
  "$workspace" "${OPENCODE_MODEL:-default}" "${SUBAGENT_SESSION:-new}" "$user_prompt" > "$log_file"

if [ "$use_systemd" -eq 1 ]; then
  systemd-run --user --pipe --same-dir --setenv=PATH="$PATH" --wait --collect --quiet --unit="$unit" --property=KillMode=control-group --property=RuntimeMaxSec="${timeout_seconds}s" "$HOME/.opencode/bin/opencode" "$@" "$prompt" >>"$log_file" 2>&1 &
elif [ "$timeout_seconds" -gt 0 ] 2>/dev/null && command -v timeout >/dev/null 2>&1; then
  setsid timeout --foreground "$timeout_seconds"s "$HOME/.opencode/bin/opencode" "$@" "$prompt" >>"$log_file" 2>&1 &
else
  setsid "$HOME/.opencode/bin/opencode" "$@" "$prompt" >>"$log_file" 2>&1 &
fi
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# ponytail: `wait` returns the waited-on process's exit status, which is
# routinely nonzero (timeouts, model errors). Under `set -e` a bare `wait`
# call there aborts the script on the spot — every cleanup line below it
# would silently never run. set +e/-e brackets just this one call so the
# real status still gets captured deliberately, not lost to errexit.
set +e
wait "$cmd_pid"
status=$?
set -e

kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if [ "$use_systemd" -eq 1 ]; then
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
elif command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# ponytail: catch what the group-kill missed — any pid that appeared during
# this run and is still rooted (via /proc/<pid>/cwd) under the workspace
# directory. Ceiling: a process that chdir's away from the workspace after
# spawning still escapes this; that's not a pattern any current subagent
# task does, so not handling it here.
workspace_real="$(cd "$workspace" && pwd -P)"
after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
new_pids=""
for pid in $after_pids; do
  case " $before_pids " in
    *" $pid "*) ;;
    *) new_pids="$new_pids $pid" ;;
  esac
done

for sig in TERM KILL; do
  if [ "$sig" = "KILL" ]; then
    sleep 1
  fi
  for pid in $new_pids; do
    pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
    if [ -z "$pid_cwd" ]; then
      continue
    fi
    case "$pid_cwd" in
      "$workspace_real"|"$workspace_real"/*)
        kill "-$sig" "$pid" >/dev/null 2>&1 || true
        ;;
    esac
  done
done

exit "$status"
