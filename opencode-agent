#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

workspace="$(pwd -P)"
canonical_workspace=""
if command -v node >/dev/null 2>&1; then
  canonical_workspace="$(node "$repo_dir/scripts/workspace-canonical.mjs" "$workspace" 2>/dev/null || true)"
fi

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

opencode_bin="${AGENT_RELAY_OPENCODE_BIN:-${SUBAGENT_OPENCODE_BIN:-$(command -v opencode 2>/dev/null || echo "$HOME/.opencode/bin/opencode")}}"

if [ "${1:-}" = "--models" ]; then
  # opencode v2 has no `models --refresh`; the flag is still accepted as a no-op.
  if [ "$#" -ne 1 ] && ! { [ "${2:-}" = "--refresh" ] && [ "$#" -eq 2 ]; }; then
    echo "Usage: opencode-agent --models" >&2
    exit 2
  fi

  # The wrapper deliberately supports only the providers documented below.
  # Do not leak every locally configured OpenCode provider to calling harnesses.
  # opencode v2 `models` takes no provider argument, so filter by prefix.
  "$opencode_bin" models | grep -E '^(opencode-go|openai|zai-coding-plan)/' || true
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  opencode-agent "task"
  printf '%s\n' "task" | opencode-agent
  opencode-agent --models

Environment:
  OPENCODE_MODEL    Model in provider/model format or family alias:
                    - 'openai/latest' / 'openai/sol' / 'gpt-sol': newest OpenAI GPT Sol (e.g. gpt-5.6-sol)
                    - 'openai/terra' / 'openai/luna' / 'openai/mini': newest specific OpenAI tier
                    - 'zai/latest' / 'glm/latest' / 'glm': newest Z.AI GLM (e.g. glm-5.3)
                    - 'zai/flash' / 'glm/flash': newest Z.AI GLM Flash
                    - 'opencode-go/qwen-latest': newest Qwen Max
                    - 'opencode-go/deepseek-latest': newest DeepSeek Pro
  OPENCODE_VARIANT  Optional model variant, e.g. high.
  OPENCODE_AGENT    Optional opencode agent name.
  OPENCODE_TIMEOUT  Optional timeout in seconds. Default: 7200.
  OPENCODE_LOGS     Print opencode logs to stderr. Default: 1.
  AGENT_RELAY_SESSION  Resume this provider's existing session ID.
  AGENT_RELAY_LOG_DIR  Where wrapper run logs are written. Default: ~/agent-relay/logs.

Every run's combined stdout+stderr (including opencode's own --print-logs
stream) is teed to a timestamped file under AGENT_RELAY_LOG_DIR (printed in the
startup banner) so a backgrounded run can be tailed live instead of waiting
for the final result.

Examples:
  OPENCODE_MODEL='openai/latest' opencode-agent "Fix the bug"
  OPENCODE_MODEL='glm/latest' opencode-agent "Review this repo"
  OPENCODE_MODEL='openai/gpt-5.6-sol' opencode-agent "Implement TASK.md"

Supported model providers: opencode-go, openai, zai-coding-plan.
Use `opencode-agent --models` to list the currently available models.
EOF
  exit 0
fi

resume_session="${AGENT_RELAY_SESSION:-${SUBAGENT_SESSION:-}}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

timeout_seconds="${OPENCODE_TIMEOUT:-7200}"
# ponytail: timeout_spec is the duration literal for `timeout`/RuntimeMaxSec;
# invalid or zero values drop both instead of corrupting the systemd property.
case "$timeout_seconds" in ''|*[!0-9]*) timeout_spec='' ;; *) timeout_spec="${timeout_seconds}s" ;; esac
log_flag="${OPENCODE_LOGS:-1}"

resolve_opencode_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  # Automatic reroute for token-heavy routes
  case "$raw_model" in
    opencode-go/glm-5.3)
      echo "opencode-agent: rerouting opencode-go/glm-5.3 -> zai-coding-plan/glm-5.3 (token-heavy route)" >&2
      echo "zai-coding-plan/glm-5.3"
      return 0
      ;;
    opencode-go/glm-5.2)
      echo "opencode-agent: rerouting opencode-go/glm-5.2 -> zai-coding-plan/glm-5.2 (token-heavy route)" >&2
      echo "zai-coding-plan/glm-5.2"
      return 0
      ;;
  esac

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    openai/latest|openai/gpt-latest|openai/sol|gpt-sol|openai/gpt|latest)
      resolved="$("$opencode_bin" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-sol$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-sol"
      ;;
    openai/terra|gpt-terra)
      resolved="$("$opencode_bin" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-terra$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-terra"
      ;;
    openai/luna|gpt-luna)
      resolved="$("$opencode_bin" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-luna$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.6-luna"
      ;;
    openai/mini|openai/gpt-mini|gpt-mini)
      resolved="$("$opencode_bin" models openai 2>/dev/null | grep -E '^openai/gpt-[0-9.]+-mini$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "openai/gpt-5.4-mini"
      ;;
    zai/latest|zai-coding-plan/latest|glm/latest|glm|zai/glm|zai-coding-plan/glm)
      resolved="$("$opencode_bin" models zai-coding-plan 2>/dev/null | grep -E '^zai-coding-plan/glm-[0-9.]+$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "zai-coding-plan/glm-5.3"
      ;;
    zai/flash|zai-coding-plan/flash|glm/flash|glm-flash)
      resolved="$("$opencode_bin" models zai-coding-plan 2>/dev/null | grep -E '^zai-coding-plan/glm-[0-9.]+-flash$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "zai-coding-plan/glm-5.3-flash"
      ;;
    opencode-go/qwen-latest|qwen-latest|qwen)
      resolved="$("$opencode_bin" models opencode-go 2>/dev/null | grep -E '^opencode-go/qwen[0-9.]+-max$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "opencode-go/qwen3.8-max"
      ;;
    opencode-go/deepseek-latest|deepseek-latest|deepseek)
      resolved="$("$opencode_bin" models opencode-go 2>/dev/null | grep -E '^opencode-go/deepseek-v[0-9.]+-pro$' | tail -n 1 || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "opencode-go/deepseek-v4-pro"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

if [ -n "${OPENCODE_MODEL:-}" ]; then
  resolved_opencode_model="$(resolve_opencode_model "$OPENCODE_MODEL")"
  if [ "$resolved_opencode_model" != "$OPENCODE_MODEL" ]; then
    echo "opencode-agent: resolved alias '$OPENCODE_MODEL' -> '$resolved_opencode_model'" >&2
    OPENCODE_MODEL="$resolved_opencode_model"
  fi
fi

log_dir="${AGENT_RELAY_LOG_DIR:-${SUBAGENT_LOG_DIR:-$repo_dir/logs}}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-opencode-$$.log"
done_file="$log_file.done"
unit="local-agent-opencode-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
done_provider="opencode"
. "$repo_dir/scripts/finalize-run.sh"
. "$repo_dir/scripts/wrapper-lib.sh"
completion_marker='message="disposing instance"|message="exiting loop"'
provider_extract_session() {
  sess_id="$(grep -oE 'session\.id=[^ ]+' "$log_file" 2>/dev/null | head -n 1 | cut -d'=' -f2 || grep -oE '"session_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || echo "${resume_session:-new}")"
}


cd "$workspace"

# opencode >=2.1 dropped --dir/--variant: a standalone server runs in the cwd above; variant rides on the model.
set -- run --standalone --auto --format json

if [ "${OPENCODE_MODEL:-}" ]; then
  set -- "$@" --model "$OPENCODE_MODEL${OPENCODE_VARIANT:+#$OPENCODE_VARIANT}"
fi

if [ "${OPENCODE_AGENT:-}" ]; then
  set -- "$@" --agent "$OPENCODE_AGENT"
fi

if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- "$@" --continue
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- "$@" --session "$resume_session"
fi

if [ "$log_flag" = "1" ]; then
  set -- "$@" --print-logs
fi

set -- "$@" "$(agent_prompt "$workspace" "$user_prompt")"

if [ "$log_flag" = "1" ]; then
  if [ -n "$canonical_workspace" ] && [ "$canonical_workspace" != "$workspace" ]; then
    echo "opencode-agent: canonical_workspace=$canonical_workspace launch_workspace=$workspace" >&2
  fi
  echo "opencode-agent: workspace=$workspace model=${OPENCODE_MODEL:-default} variant=${OPENCODE_VARIANT:-default} agent=${OPENCODE_AGENT:-default} session=${resume_session:-new} timeout=${timeout_seconds}s run_log=$log_file" >&2
fi

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
done_model="${OPENCODE_MODEL:-default}"
provider_name="opencode"
runner_bin="$opencode_bin"
run_agent_runtime "$@"
