#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

LOGS_DIR="${AGENT_RELAY_LOG_DIR:-${SUBAGENT_LOG_DIR:-$repo_dir/logs}}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'HELP'
Usage:
  agent-wait [LOG_FILE | PID | --last]
  agent-wait LOG_1 LOG_2 ...

Description:
  Waits for one or more background local agents to complete using zero-polling
  OS process monitors. Unblocks immediately upon process exit and outputs the
  structured task result JSON. Use this for completeness checks instead of
  tailing logs. If session reuse is possible, the JSON includes continuation
  commands for follow-up fixes. Exits nonzero when any structured result is not
  accepted.

Examples:
  agent-wait --last
  agent-wait 20260817T193219-antigravity-3345675.log
  agent-wait 3345675
  agent-wait "$log1" "$log2"
HELP
  exit 0
fi

# If no args or --last, find the most recent log file
if [ "$#" -eq 0 ] || [ "${1:-}" = "--last" ]; then
  latest_log="$(ls -t "$LOGS_DIR"/*.log 2>/dev/null | head -n 1 || true)"
  if [ -z "$latest_log" ]; then
    echo "agent-wait: no agent logs found in $LOGS_DIR" >&2
    exit 1
  fi
  set -- "$latest_log"
fi

overall_status=0

for target in "$@"; do
  log_path=""
  pid=""

  # Check if target is a numeric PID
  if [ "$target" -eq "$target" ] 2>/dev/null; then
    pid="$target"
    log_path="$(ls "$LOGS_DIR"/*-"$pid".log 2>/dev/null | head -n 1 || true)"
  elif [ -f "$target" ]; then
    log_path="$target"
    pid="$(basename "$target" .log | grep -oE '[0-9]+$' || true)"
  elif [ -f "$LOGS_DIR/$target" ]; then
    log_path="$LOGS_DIR/$target"
    pid="$(basename "$target" .log | grep -oE '[0-9]+$' || true)"
  else
    echo "agent-wait: target not found: $target" >&2
    overall_status=1
    continue
  fi

  # If PID is running, wait on it with zero CPU usage
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    tail --pid="$pid" -f /dev/null 2>/dev/null || while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
  fi

  # Check for .done sentinel or log metadata
  done_file="${log_path%.log}.done"
  if command -v node >/dev/null 2>&1; then
    set +e
    result_json="$(node "$repo_dir/scripts/agent-result.js" "$log_path" 2>/dev/null)"
    result_status=$?
    set -e
    if [ "$result_status" -eq 0 ] && [ -n "$result_json" ]; then
      printf '%s\n' "$result_json"
      if ! printf '%s' "$result_json" | node -e 'let s=""; process.stdin.on("data", d => s += d).on("end", () => { try { process.exit(JSON.parse(s).accepted === true ? 0 : 1); } catch { process.exit(1); } });'; then
        overall_status=1
      fi
      continue
    fi
  fi

  if [ -f "$done_file" ]; then
    sed -n '1,200p' "$done_file"
  elif [ -n "$log_path" ] && [ -f "$log_path" ]; then
    echo "=== Agent Run Finished: $(basename "$log_path") ==="
    tail -n 15 "$log_path"
  else
    echo "agent-wait: process $pid finished"
  fi
done

exit "$overall_status"
