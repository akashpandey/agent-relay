#!/usr/bin/env sh
set -eu

timeout="${AGY_PRINT_TIMEOUT:-20m}"
workspace="$(pwd -P)"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: antigravity-subagent --models" >&2
    exit 2
  fi
  "$HOME/.local/bin/agy" models
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  antigravity-subagent "task"
  printf '%s\n' "task" | antigravity-subagent
  antigravity-subagent --models

Environment:
  AGY_MODEL          Model label exactly as shown below.
  AGY_PRINT_TIMEOUT  Print-mode timeout, default: 20m.
  AGY_LOG_FILE       Optional agy --log-file path (agy's own internal log).
  AGY_LOGS           Print wrapper banner to stderr. Default: 1.
  SUBAGENT_LOG_DIR   Where wrapper run logs are written. Default: ~/local-subagents/logs.

Every run's combined stdout+stderr is teed to a timestamped file under
SUBAGENT_LOG_DIR (printed in the startup banner) so a backgrounded run can be
tailed live instead of waiting for --print to return.

Examples:
  AGY_MODEL='Gemini 3.6 Flash (Medium)' antigravity-subagent "Fix the bug"
  AGY_MODEL='Claude Sonnet 4.6 (Thinking)' antigravity-subagent "Review this repo"
  AGY_MODEL='GPT-OSS 120B (Medium)' antigravity-subagent "Implement TASK.md"

Antigravity models:
  Gemini 3.6 Flash (High)
  Gemini 3.6 Flash (Medium)
  Gemini 3.6 Flash (Low)
  Gemini 3.5 Flash (High)
  Gemini 3.5 Flash (Medium)
  Gemini 3.5 Flash (Low)
  Gemini 3.1 Pro (High)
  Gemini 3.1 Pro (Low)
  Claude Sonnet 4.6 (Thinking)
  Claude Opus 4.6 (Thinking)
  GPT-OSS 120B (Medium)

Refresh live list:
  antigravity-subagent --models
EOF
  exit 0
fi

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

prompt="You are running as a non-interactive coding subagent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Do not put deliverables in Antigravity scratch.
- After editing, summarize changed files and verification commands.

Task:
$user_prompt"

log_flag="${AGY_LOGS:-1}"

log_dir="${SUBAGENT_LOG_DIR:-$HOME/local-subagents/logs}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-antigravity-$$.log"

set -- --print "$prompt" --add-dir "$workspace" --dangerously-skip-permissions --print-timeout "$timeout"

if [ "${AGY_MODEL:-}" ]; then
  set -- --model "$AGY_MODEL" "$@"
fi

if [ "${AGY_LOG_FILE:-}" ]; then
  set -- --log-file "$AGY_LOG_FILE" "$@"
fi

if [ "$log_flag" = "1" ]; then
  echo "antigravity-subagent: workspace=$workspace model=${AGY_MODEL:-default} timeout=$timeout log_file=${AGY_LOG_FILE:-default} run_log=$log_file" >&2
fi

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"

setsid "$HOME/.local/bin/agy" "$@" >"$log_file" 2>&1 &
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# ponytail: `wait` returns the waited-on process's exit status, which is
# routinely nonzero (timeouts, model errors). Under `set -e` a bare `wait`
# call there aborts the script on the spot — every cleanup line below it
# would silently never run. set +e/-e brackets just this one call so the
# real status still gets captured deliberately, not lost to errexit.
set +e
wait "$cmd_pid"
status=$?
set -e

kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# ponytail: catch what the group-kill missed — any pid that appeared during
# this run and is still rooted (via /proc/<pid>/cwd) under the workspace
# directory. Ceiling: a process that chdir's away from the workspace after
# spawning still escapes this; that's not a pattern any current subagent
# task does, so not handling it here.
workspace_real="$(cd "$workspace" && pwd -P)"
after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
new_pids=""
for pid in $after_pids; do
  case " $before_pids " in
    *" $pid "*) ;;
    *) new_pids="$new_pids $pid" ;;
  esac
done

for sig in TERM KILL; do
  if [ "$sig" = "KILL" ]; then
    sleep 1
  fi
  for pid in $new_pids; do
    pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
    if [ -z "$pid_cwd" ]; then
      continue
    fi
    case "$pid_cwd" in
      "$workspace_real"|"$workspace_real"/*)
        kill "-$sig" "$pid" >/dev/null 2>&1 || true
        ;;
    esac
  done
done

exit "$status"
