#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

timeout="${AGY_PRINT_TIMEOUT:-120m}"
workspace="$(pwd -P)"

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: antigravity-subagent --models" >&2
    exit 2
  fi
  "$HOME/.local/bin/agy" models
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  antigravity-subagent "task"
  printf '%s\n' "task" | antigravity-subagent
  antigravity-subagent --models

Environment:
  AGY_MODEL          Model label exactly as shown below.
  AGY_PRINT_TIMEOUT  Print-mode timeout, default: 120m.
  AGY_LOG_FILE       Optional agy --log-file path (agy's own internal log).
  AGY_LOGS           Print wrapper banner to stderr. Default: 1.
  SUBAGENT_SESSION   Resume this provider's existing conversation ID.
  SUBAGENT_LOG_DIR   Where wrapper run logs are written. Default: ~/local-subagents/logs.

Every run's combined stdout+stderr is teed to a timestamped file under
SUBAGENT_LOG_DIR (printed in the startup banner) so a backgrounded run can be
tailed live instead of waiting for --print to return.

Examples:
  AGY_MODEL='Gemini 3.6 Flash (Medium)' antigravity-subagent "Fix the bug"
  AGY_MODEL='Gemini 3.7 Flash (High)' antigravity-subagent "Review this repo"
  AGY_MODEL='GPT-OSS 120B (Medium)' antigravity-subagent "Implement TASK.md"

Antigravity models:
  Gemini 3.7 Flash (High)
  Gemini 3.7 Flash (Medium)
  Gemini 3.7 Flash (Low)
  Gemini 3.6 Flash (High)
  Gemini 3.6 Flash (Medium)
  Gemini 3.6 Flash (Low)
  Gemini 3.5 Flash (High)
  Gemini 3.5 Flash (Medium)
  Gemini 3.5 Flash (Low)
  Gemini 3.1 Pro (High)
  Gemini 3.1 Pro (Low)
  Claude Opus 4.6 (Thinking)
  GPT-OSS 120B (Medium)

Refresh live list:
  antigravity-subagent --models
EOF
  exit 0
fi

resume_session="${SUBAGENT_SESSION:-}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

export CI="${CI:-1}"
export npm_config_yes="${npm_config_yes:-true}"
export npm_config_fund="${npm_config_fund:-false}"
export npm_config_audit="${npm_config_audit:-false}"
export DEBIAN_FRONTEND="${DEBIAN_FRONTEND:-noninteractive}"
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"
export PAGER="${PAGER:-cat}"
export GIT_PAGER="${GIT_PAGER:-cat}"
export SYSTEMD_PAGER="${SYSTEMD_PAGER:-cat}"

prompt="You are running as a non-interactive coding subagent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Run all commands in non-interactive batch mode (e.g. use 'npx -y', avoid interactive stdin/prompts).
- Do not put deliverables in Antigravity scratch.
- After editing, summarize changed files and verification commands.

Task:
$user_prompt"

log_flag="${AGY_LOGS:-1}"

log_dir="${SUBAGENT_LOG_DIR:-$repo_dir/logs}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-antigravity-$$.log"
unit="local-subagent-antigravity-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""

stop_subagent() {
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
trap 'stop_subagent' EXIT
trap 'stop_subagent; exit 143' HUP INT TERM

cd "$workspace"
project_id="${AGY_PROJECT:-subagent-$(basename "$workspace")}"

set -- --print "$prompt" --output-format stream-json --project "$project_id" --dangerously-skip-permissions --print-timeout "$timeout"

if [ "${AGY_MODEL:-}" ]; then
  set -- --model "$AGY_MODEL" "$@"
fi

if [ "${AGY_LOG_FILE:-}" ]; then
  set -- --log-file "$AGY_LOG_FILE" "$@"
fi

if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- --continue "$@"
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- --conversation "$resume_session" "$@"
fi

if [ "$log_flag" = "1" ]; then
  echo "antigravity-subagent: workspace=$workspace project=$project_id model=${AGY_MODEL:-default} session=${resume_session:-new} timeout=$timeout log_file=${AGY_LOG_FILE:-default} run_log=$log_file" >&2
fi

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"

printf 'subagent: provider=antigravity workspace=%s model=%s session=%s\nTask:\n%s\n\n---\n\n' \
  "$workspace" "${AGY_MODEL:-default}" "${resume_session:-new}" "$user_prompt" > "$log_file"

# Register run start in SQLite database immediately
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" start "$(basename "$log_file")" "$$" "antigravity" "${AGY_MODEL:-default}" "$workspace" "${resume_session:-new}" "$user_prompt" >/dev/null 2>&1 || true
fi

if [ "$use_systemd" -eq 1 ]; then
  systemd-run --user --pipe --working-directory="$workspace" --setenv=PATH="$PATH" --wait --collect --quiet --unit="$unit" --property=KillMode=control-group --property=RuntimeMaxSec="$timeout" "$HOME/.local/bin/agy" "$@" >>"$log_file" 2>&1 &
elif command -v timeout >/dev/null 2>&1; then
  setsid timeout --foreground "$timeout" "$HOME/.local/bin/agy" "$@" >>"$log_file" 2>&1 &
else
  setsid "$HOME/.local/bin/agy" "$@" >>"$log_file" 2>&1 &
fi
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# ponytail: `wait` returns the waited-on process's exit status, which is
# routinely nonzero (timeouts, model errors). Under `set -e` a bare `wait`
# call there aborts the script on the spot — every cleanup line below it
# would silently never run. set +e/-e brackets just this one call so the
# real status still gets captured deliberately, not lost to errexit.
set +e
wait "$cmd_pid"
status=$?
set -e

kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if [ "$use_systemd" -eq 1 ]; then
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
elif command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# ponytail: catch what the group-kill missed — any pid that appeared during
# this run and is still rooted (via /proc/<pid>/cwd) under the workspace
# directory. Ceiling: a process that chdir's away from the workspace after
# spawning still escapes this; that's not a pattern any current subagent
# task does, so not handling it here.
workspace_real="$(cd "$workspace" && pwd -P)"
after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
new_pids=""
for pid in $after_pids; do
  case " $before_pids " in
    *" $pid "*) ;;
    *) new_pids="$new_pids $pid" ;;
  esac
done

for sig in TERM KILL; do
  if [ "$sig" = "KILL" ]; then
    sleep 1
  fi
  for pid in $new_pids; do
    pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
    if [ -z "$pid_cwd" ]; then
      continue
    fi
    case "$pid_cwd" in
      "$workspace_real"|"$workspace_real"/*)
        kill "-$sig" "$pid" >/dev/null 2>&1 || true
        ;;
    esac
  done
done

# Write completion sentinel file (.done)
done_file="${log_file%.log}.done"
conv_id="$(grep -oE '"conversation_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || echo "${resume_session:-new}")"
cat <<DONE_JSON > "$done_file"
{
  "status": "$([ "$status" -eq 0 ] && echo "completed" || echo "failed")",
  "exitCode": $status,
  "provider": "antigravity",
  "workspace": "$workspace",
  "model": "${AGY_MODEL:-default}",
  "sessionId": "$conv_id",
  "logFile": "$log_file",
  "completedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
DONE_JSON

# Automatically ingest subagent session to claude-mem (non-blocking)
if [ -f "$done_file" ] && command -v bun >/dev/null 2>&1; then
  bun "$repo_dir/scripts/ingest-to-claude-mem.js" "$done_file" >/dev/null 2>&1 &
fi

# Register run completion in SQLite database
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" complete "$(basename "$log_file")" "$status" "$conv_id" >/dev/null 2>&1 || true
fi

if [ "$log_flag" = "1" ]; then
  echo "antigravity-subagent: finished status=$status ($([ "$status" -eq 0 ] && echo "completed" || echo "failed")) session=$conv_id" >&2
fi

exit "$status"
