#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

workspace="$(pwd -P)"
canonical_workspace=""
if command -v node >/dev/null 2>&1; then
  canonical_workspace="$(node "$repo_dir/scripts/workspace-canonical.mjs" "$workspace" 2>/dev/null || true)"
fi
timeout_seconds="${CLAUDE_TIMEOUT:-7200}"

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: claude-subagent --models" >&2
    exit 2
  fi
  echo "claude-subagent: Claude Code has no live model-list command; showing documented selectors." >&2
  printf '%s\n' opus sonnet
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  claude-subagent "task"
  printf '%s\n' "task" | claude-subagent
  claude-subagent --models

Environment:
  CLAUDE_MODEL           Model alias or full model ID.
  CLAUDE_FALLBACK_MODEL  Comma-separated fallback aliases or IDs.
  CLAUDE_EFFORT          Optional effort: low, medium, high, xhigh, or max.
  SUBAGENT_SESSION       Resume this provider's existing session ID.
  CLAUDE_TIMEOUT         Timeout in seconds. Default: 7200.
  CLAUDE_LOGS            Print wrapper banner to stderr. Default: 1.
  SUBAGENT_LOG_DIR       Where wrapper run logs are written. Default: ~/local-subagents/logs.

Examples:
  CLAUDE_MODEL='sonnet' claude-subagent "Fix the bug"
  CLAUDE_MODEL='opus' CLAUDE_EFFORT='high' claude-subagent "Review this repo"
  CLAUDE_MODEL='sonnet' claude-subagent "Implement TASK.md"

Claude Code has no live model-list command. `claude-subagent --models` prints
the available documented selectors: opus and sonnet.
EOF
  exit 0
fi

resume_session="${SUBAGENT_SESSION:-}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

export CI="${CI:-1}"
export npm_config_yes="${npm_config_yes:-true}"
export npm_config_fund="${npm_config_fund:-false}"
export npm_config_audit="${npm_config_audit:-false}"
export DEBIAN_FRONTEND="${DEBIAN_FRONTEND:-noninteractive}"
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"
export PAGER="${PAGER:-cat}"
export GIT_PAGER="${GIT_PAGER:-cat}"
export SYSTEMD_PAGER="${SYSTEMD_PAGER:-cat}"

prompt="You are running as a non-interactive coding subagent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Run all commands in non-interactive batch mode (e.g. use 'npx -y', avoid interactive stdin/prompts).
- After editing, summarize changed files and verification commands.
- End your final response with a JSON object containing: outcome (done|partial|blocked|failed), summary, changedFiles, verification, blockers, incomplete, nextSteps. The JSON object must be the last non-whitespace content. Do not write anything after it. Each verification item must be an object with command, status (passed|failed|skipped), and optional reason.
- Use outcome=done only when the requested task is complete and verification passed or was explicitly unnecessary.

Task:
$user_prompt"

log_flag="${CLAUDE_LOGS:-1}"
log_dir="${SUBAGENT_LOG_DIR:-$repo_dir/logs}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-claude-$$.log"
unit="local-subagent-claude-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
trap 'stop_subagent' EXIT
trap 'stop_subagent; exit 143' HUP INT TERM

resolve_claude_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    latest|claude-latest)
      echo "sonnet"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

cd "$workspace"

if [ -n "${CLAUDE_MODEL:-}" ]; then
  resolved_claude_model="$(resolve_claude_model "$CLAUDE_MODEL")"
  if [ "$resolved_claude_model" != "$CLAUDE_MODEL" ]; then
    echo "claude-subagent: resolved alias '$CLAUDE_MODEL' -> '$resolved_claude_model'" >&2
    CLAUDE_MODEL="$resolved_claude_model"
  fi
fi

set -- --print --verbose --output-format stream-json --dangerously-skip-permissions
if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- "$@" --continue
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- "$@" --resume "$resume_session"
fi
[ -z "${CLAUDE_MODEL:-}" ] || set -- "$@" --model "$CLAUDE_MODEL"
[ -z "${CLAUDE_FALLBACK_MODEL:-}" ] || set -- "$@" --fallback-model "$CLAUDE_FALLBACK_MODEL"
[ -z "${CLAUDE_EFFORT:-}" ] || set -- "$@" --effort "$CLAUDE_EFFORT"
set -- "$@" "$prompt"

if [ "$log_flag" = "1" ]; then
  if [ -n "$canonical_workspace" ] && [ "$canonical_workspace" != "$workspace" ]; then
    echo "claude-subagent: canonical_workspace=$canonical_workspace launch_workspace=$workspace" >&2
  fi
  echo "claude-subagent: workspace=$workspace model=${CLAUDE_MODEL:-default} effort=${CLAUDE_EFFORT:-default} fallback=${CLAUDE_FALLBACK_MODEL:-none} session=${resume_session:-new} timeout=${timeout_seconds}s run_log=$log_file" >&2
fi

# ponytail: a separate process group makes timeout cleanup cover ordinary children.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
printf 'subagent: provider=claude workspace=%s model=%s session=%s\nTask:\n%s\n\n---\n\n' \
  "$workspace" "${CLAUDE_MODEL:-default}" "${resume_session:-new}" "$user_prompt" > "$log_file"

# Register run start in SQLite database immediately
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" start "$(basename "$log_file")" "$$" "claude" "${CLAUDE_MODEL:-default}" "$workspace" "${resume_session:-new}" "$user_prompt" >/dev/null 2>&1 || true
fi

if [ "$use_systemd" -eq 1 ]; then
  systemd-run --user --pipe --working-directory="$workspace" --setenv=PATH="$PATH" --wait --collect --quiet --unit="$unit" --property=KillMode=control-group --property=RuntimeMaxSec="${timeout_seconds}s" "$HOME/.local/bin/claude" "$@" >>"$log_file" 2>&1 &
elif [ "$timeout_seconds" -gt 0 ] 2>/dev/null && command -v timeout >/dev/null 2>&1; then
  setsid timeout --foreground "${timeout_seconds}s" "$HOME/.local/bin/claude" "$@" >>"$log_file" 2>&1 &
else
  setsid "$HOME/.local/bin/claude" "$@" >>"$log_file" 2>&1 &
fi
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# Background watchdog: reap hanging runtime if task completed but lingering event-loop handles prevent exit
(
  while kill -0 "$cmd_pid" 2>/dev/null; do
    sleep 2
    if grep -qE '"type":"result"' "$log_file" 2>/dev/null || \
       awk '/^---$/{f=1; next} f' "$log_file" 2>/dev/null | grep -qE '(\\"|")outcome(\\"|"):[[:space:]]*(\\"|")(done|partial|blocked|failed)'; then
      grace=6
      while [ "$grace" -gt 0 ] && kill -0 "$cmd_pid" 2>/dev/null; do
        sleep 1
        grace=$((grace - 1))
      done
      if kill -0 "$cmd_pid" 2>/dev/null; then
        touch "${log_file}.reaped"
        if [ "$use_systemd" -eq 1 ]; then
          systemctl --user stop "$unit" >/dev/null 2>&1 || true
        elif command -v pkill >/dev/null 2>&1; then
          pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
          sleep 1
          pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
        fi
      fi
      break
    fi
  done
) &
watchdog_pid=$!

set +e
wait "$cmd_pid"
status=$?
set -e

kill "$watchdog_pid" >/dev/null 2>&1 || true
wait "$watchdog_pid" 2>/dev/null || true
kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if [ -f "${log_file}.reaped" ]; then
  rm -f "${log_file}.reaped"
  if [ "$status" -ne 0 ]; then
    if [ "$log_flag" = "1" ]; then
      echo "claude-subagent: process reaped after task completion (lingering event-loop handles)" >&2
    fi
    status=0
  fi
fi
if [ "$use_systemd" -eq 1 ]; then
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
elif command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# Clean up orphaned processes in the workspace (only in non-systemd fallback mode)
if [ "$use_systemd" -eq 0 ]; then
  workspace_real="$(cd "$workspace" && pwd -P)"
  after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
  new_pids=""
  for pid in $after_pids; do
    case " $before_pids " in
      *" $pid "*) ;;
      *) new_pids="$new_pids $pid" ;;
    esac
  done

  for sig in TERM KILL; do
    if [ "$sig" = "KILL" ]; then
      sleep 1
    fi
    for pid in $new_pids; do
      [ "$pid" = "$$" ] && continue
      pid_cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
      case "$pid_cmd" in
        *-subagent*|*systemd-run*|*claude*|*codex*|*opencode*|*antigravity*|*agy*)
          continue
          ;;
      esac
      pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
      if [ -z "$pid_cwd" ]; then
        continue
      fi
      case "$pid_cwd" in
        "$workspace_real"|"$workspace_real"/*)
          kill "-$sig" "$pid" >/dev/null 2>&1 || true
          ;;
      esac
    done
  done
fi

# Write completion sentinel file (.done)
done_file="${log_file%.log}.done"
sess_id="$(grep -oE '"session_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || echo "${resume_session:-new}")"
cat <<DONE_JSON > "$done_file"
{
  "status": "$([ "$status" -eq 0 ] && echo "completed" || echo "failed")",
  "exitCode": $status,
  "provider": "claude",
  "workspace": "$workspace",
  "model": "${CLAUDE_MODEL:-default}",
  "sessionId": "$sess_id",
  "logFile": "$log_file",
  "completedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
DONE_JSON

# Automatically ingest subagent session to claude-mem (non-blocking)
if [ -f "$done_file" ] && command -v bun >/dev/null 2>&1; then
  bun "$repo_dir/scripts/ingest-to-claude-mem.js" "$done_file" >/dev/null 2>&1 &
fi

# Register run completion in SQLite database
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" complete "$(basename "$log_file")" "$status" "$sess_id" >/dev/null 2>&1 || true
fi

if [ "$log_flag" = "1" ]; then
  echo "claude-subagent: finished status=$status ($([ "$status" -eq 0 ] && echo "completed" || echo "failed")) session=$sess_id" >&2
fi

exit "$status"
