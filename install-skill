#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
source_dir="$repo_dir/skills/local-subagents"

for target in \
  "$HOME/.agents/skills/local-subagents" \
  "$HOME/.claude/skills/local-subagents" \
  "$HOME/.gemini/skills/local-subagents" \
  "$HOME/.config/opencode/skills/local-subagents" \
  "$HOME/.codex/skills/local-subagents"; do
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "Replacing directory with symlink: $target"
    rm -rf "$target"
  fi
  mkdir -p "$(dirname -- "$target")"
  ln -sfnT "$source_dir" "$target"
  echo "Installed: $target -> $source_dir"
done
