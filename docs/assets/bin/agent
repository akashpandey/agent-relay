#!/usr/bin/env bash
set -e

GREEN="\033[0;32m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
YELLOW="\033[1;33m"
BOLD="\033[1m"
MAGENTA="\033[0;35m"
RESET="\033[0m"

cmd="${1:-}"

case "$cmd" in
  doctor)
    echo -e "${GREEN}[OK]${RESET} docker CLI available"
    echo -e "${GREEN}[OK]${RESET} docker daemon reachable"
    echo -e "${GREEN}[OK]${RESET} compose symlink points to repo"
    echo -e "${GREEN}[OK]${RESET} post-commit hook installed"
    echo -e "${GREEN}[OK]${RESET} restart script executable"
    echo -e "${GREEN}[OK]${RESET} dashboard container running"
    echo -e "${GREEN}[OK]${RESET} dashboard HTTP reachable (:4242)"
    ;;
  workspaces)
    printf "%-18s %-30s %s\n" "web-api" "~/Code/web-api" "34 runs"
    printf "%-18s %-30s %s\n" "frontend" "~/Code/frontend" "18 runs"
    printf "%-18s %-30s %s\n" "agent-relay" "~/Code/agent-relay" "42 runs"
    ;;
  claude|opencode|codex|antigravity)
    provider="$1"
    task="${2:-Refactor auth middleware to JWT}"
    model="claude-3-7-sonnet"
    [ "$provider" = "codex" ] && model="gpt-5.6-sol"
    [ "$provider" = "opencode" ] && model="gpt-5.5"
    [ "$provider" = "antigravity" ] && model="gemini-2.5-pro"
    echo -e "${CYAN}[agent]${RESET} workspace=${BOLD}~/Code/web-api${RESET}"
    echo -e "${CYAN}[agent]${RESET} provider=${BOLD}${provider}${RESET} model=${YELLOW}${model}${RESET} log=logs/20260917T113000-${provider}-8412.log"
    echo -e "${GREEN}[agent]${RESET} dispatched task: \"${task}\""
    echo -e "${BLUE}[agent]${RESET} running in background (pid 8412)..."
    ;;
  takeover)
    target_provider="${2:-codex}"
    task="${3:-Finish the JWT auth refactor and verify}"
    echo -e "${MAGENTA}[relay]${RESET} transferring baton: ${BOLD}CLAUDE${RESET} ➔ ${BOLD}${target_provider^^}${RESET}"
    echo -e "${MAGENTA}[relay]${RESET} workspace: ~/Code/web-api"
    echo -e "${MAGENTA}[relay]${RESET} handoff reason: Context Window Exceeded"
    echo -e "${MAGENTA}[relay]${RESET} files in flight: 3 (middleware/auth.ts, routes/login.ts, tests/auth.test.ts)"
    echo -e "${CYAN}[agent]${RESET} provider=${BOLD}${target_provider}${RESET} model=${YELLOW}gpt-5.6-sol${RESET} log=logs/20260917T113200-${target_provider}-8530.log"
    echo -e "${GREEN}[agent]${RESET} dispatched task: \"${task}\""
    echo -e "${BLUE}[agent]${RESET} running in background (pid 8530)..."
    ;;
  result)
    cat << 'EOF'
{
  "filename": "20260917T113200-codex-8530.log",
  "provider": "codex",
  "model": "openai/gpt-5.6-sol",
  "outcome": "done",
  "accepted": true,
  "verification": [
    { "command": "npm test", "status": "passed" }
  ],
  "changedFiles": [
    "middleware/auth.ts",
    "routes/login.ts",
    "tests/auth.test.ts"
  ],
  "summary": "Completed JWT token refresh and boundary handling. All 18 unit tests passed.",
  "continuation": {
    "runAgainCommand": "relay takeover web-api codex"
  }
}
EOF
    ;;
  *)
    echo "Usage: relay <doctor | workspaces | claude | codex | opencode | takeover | result>"
    ;;
esac
