#!/usr/bin/env bash
set -e

GREEN="\033[0;32m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
YELLOW="\033[1;33m"
BOLD="\033[1m"
RESET="\033[0m"

cmd="${1:-}"

case "$cmd" in
  doctor)
    echo -e "${GREEN}[OK]${RESET} docker CLI available"
    echo -e "${GREEN}[OK]${RESET} docker daemon reachable"
    echo -e "${GREEN}[OK]${RESET} compose symlink points to repo"
    echo -e "${GREEN}[OK]${RESET} post-commit hook installed"
    echo -e "${GREEN}[OK]${RESET} restart script executable"
    echo -e "${GREEN}[OK]${RESET} dashboard container running"
    echo -e "${GREEN}[OK]${RESET} dashboard HTTP reachable"
    ;;
  workspaces)
    printf "%-18s %-32s %s\n" "fitschool" "~/Code/fitschool" "295 runs"
    printf "%-18s %-32s %s\n" "OfdcApplication" "~/Code/OfdcApplication" "25 runs"
    printf "%-18s %-32s %s\n" "local-subagents" "~/Code/local-subagents" "22 runs"
    printf "%-18s %-32s %s\n" "DreamsToDestiny" "~/Code/DreamsToDestiny" "17 runs"
    ;;
  opencode|codex|claude|antigravity)
    provider="$1"
    task="${2:-Task delegated to subagent}"
    echo -e "${CYAN}[subagent]${RESET} launch_dir=${BOLD}$(pwd)${RESET}"
    echo -e "${CYAN}[subagent]${RESET} canonical_workspace=${BOLD}local-subagents${RESET}"
    echo -e "${CYAN}[subagent]${RESET} provider=${BOLD}${provider}${RESET} model=${YELLOW}gpt-5.6-sol${RESET} log=logs/20260915T043000-${provider}-4123.log"
    echo -e "${GREEN}[subagent]${RESET} dispatched task: \"${task}\""
    echo -e "${BLUE}[subagent]${RESET} running in background (pid 4123)..."
    ;;
  result)
    cat << 'EOF'
{
  "filename": "20260915T043000-opencode-4123.log",
  "provider": "opencode",
  "model": "openai/gpt-5.6-sol",
  "outcome": "done",
  "accepted": true,
  "verification": [
    { "command": "npm test", "status": "passed" }
  ],
  "summary": "Verified auth token refresh and boundary handling. Tests pass.",
  "continuation": {
    "subagentContinueCommand": "subagent continue 'local-subagents' '<follow-up task>'"
  }
}
EOF
    ;;
  *)
    echo "Usage: subagent <doctor | workspaces | opencode | codex | claude | antigravity | result>"
    ;;
esac
