#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

timeout="${AGY_PRINT_TIMEOUT:-120m}"
timeout_spec="$timeout"
workspace="$(pwd -P)"
canonical_workspace=""
if command -v node >/dev/null 2>&1; then
  canonical_workspace="$(node "$repo_dir/scripts/workspace-canonical.mjs" "$workspace" 2>/dev/null || true)"
fi

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

agy_bin="${AGENT_RELAY_AGY_BIN:-${SUBAGENT_AGY_BIN:-$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")}}"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: antigravity-agent --models" >&2
    exit 2
  fi
  "$agy_bin" models
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  antigravity-agent "task"
  printf '%s\n' "task" | antigravity-agent
  antigravity-agent --models

Environment:
  AGY_MODEL          Model label (e.g. 'Gemini 3.8 Flash (High)') or family alias:
                     - 'gemini-flash' / 'flash' / 'latest': dynamically resolves newest Gemini Flash (High)
                     - 'gemini-flash-medium' / 'flash-med': dynamically resolves newest Gemini Flash (Medium)
                     - 'gemini-flash-low' / 'flash-low': dynamically resolves newest Gemini Flash (Low)
                     - 'gemini-pro' / 'pro': dynamically resolves newest Gemini Pro (High)
                     - 'claude-opus' / 'opus': Claude Opus Thinking
                     - 'gpt-oss' / 'gpt': GPT-OSS 120B
  AGY_PRINT_TIMEOUT  Print-mode timeout, default: 120m.
  AGY_LOG_FILE       Optional agy --log-file path (agy's own internal log).
  AGY_LOGS           Print wrapper banner to stderr. Default: 1.
  AGENT_RELAY_SESSION   Resume this provider's existing conversation ID.
  AGENT_RELAY_LOG_DIR   Where wrapper run logs are written. Default: ~/agent-relay/logs.

Every run's combined stdout+stderr is teed to a timestamped file under
AGENT_RELAY_LOG_DIR (printed in the startup banner) so a backgrounded run can be
tailed live instead of waiting for --print to return.

Examples:
  AGY_MODEL='gemini-flash' antigravity-agent "Fix the bug"
  AGY_MODEL='gemini-pro' antigravity-agent "Review this repo"
  AGY_MODEL='Gemini 3.8 Flash (High)' antigravity-agent "Implement TASK.md"

Refresh live list:
  antigravity-agent --models
EOF
  exit 0
fi

resume_session="${AGENT_RELAY_SESSION:-${SUBAGENT_SESSION:-}}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

log_flag="${AGY_LOGS:-1}"

log_dir="${AGENT_RELAY_LOG_DIR:-${SUBAGENT_LOG_DIR:-$repo_dir/logs}}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-antigravity-$$.log"
unit="local-agent-antigravity-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
done_provider="antigravity"
. "$repo_dir/scripts/finalize-run.sh"
. "$repo_dir/scripts/wrapper-lib.sh"
completion_marker='"type":"result"'
provider_outcome_re='"outcome"[[:space:]]*:[[:space:]]*"(done|partial|blocked|failed)".*"changedFiles"'

provider_extract_session() {
  sess_id="$(grep -oE '"conversation_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || echo "${resume_session:-new}")"
}


resolve_agy_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    flash|gemini-flash|latest-flash|flash-high|latest)
      resolved="$("$agy_bin" models 2>/dev/null | grep -iE 'Gemini [0-9.]+ Flash \(High\)' | head -n 1 | sed -e 's/^[a-z0-9.-]*[[:space:]]*//' || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "Gemini 3.8 Flash (High)"
      ;;
    flash-medium|gemini-flash-medium|flash-med)
      resolved="$("$agy_bin" models 2>/dev/null | grep -iE 'Gemini [0-9.]+ Flash \(Medium\)' | head -n 1 | sed -e 's/^[a-z0-9.-]*[[:space:]]*//' || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "Gemini 3.8 Flash (Medium)"
      ;;
    flash-low|gemini-flash-low)
      resolved="$("$agy_bin" models 2>/dev/null | grep -iE 'Gemini [0-9.]+ Flash \(Low\)' | head -n 1 | sed -e 's/^[a-z0-9.-]*[[:space:]]*//' || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "Gemini 3.8 Flash (Low)"
      ;;
    pro|gemini-pro|latest-pro|pro-high)
      resolved="$("$agy_bin" models 2>/dev/null | grep -iE 'Gemini [0-9.]+ Pro \(High\)' | head -n 1 | sed -e 's/^[a-z0-9.-]*[[:space:]]*//' || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "Gemini 3.1 Pro (High)"
      ;;
    pro-low|gemini-pro-low)
      resolved="$("$agy_bin" models 2>/dev/null | grep -iE 'Gemini [0-9.]+ Pro \(Low\)' | head -n 1 | sed -e 's/^[a-z0-9.-]*[[:space:]]*//' || true)"
      if [ -n "$resolved" ]; then echo "$resolved"; return 0; fi
      echo "Gemini 3.1 Pro (Low)"
      ;;
    claude-opus|opus)
      echo "Claude Opus 4.6 (Thinking)"
      ;;
    claude-sonnet|sonnet)
      echo "Claude Sonnet 4.6 (Thinking)"
      ;;
    gpt-oss|gpt)
      echo "GPT-OSS 120B (Medium)"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

cd "$workspace"
project_id="${AGY_PROJECT:-subagent-$(basename "$workspace")}"

if [ -n "${AGY_MODEL:-}" ]; then
  resolved_agy_model="$(resolve_agy_model "$AGY_MODEL")"
  if [ "$resolved_agy_model" != "$AGY_MODEL" ]; then
    echo "antigravity-agent: resolved alias '$AGY_MODEL' -> '$resolved_agy_model'" >&2
    AGY_MODEL="$resolved_agy_model"
  fi
fi

set -- --print "$(agent_prompt "$workspace" "$user_prompt")" --output-format stream-json --project "$project_id" --dangerously-skip-permissions --print-timeout "$timeout"

if [ "${AGY_MODEL:-}" ]; then
  set -- --model "$AGY_MODEL" "$@"
fi

if [ "${AGY_LOG_FILE:-}" ]; then
  set -- --log-file "$AGY_LOG_FILE" "$@"
fi

if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- --continue "$@"
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- --conversation "$resume_session" "$@"
fi

if [ "$log_flag" = "1" ]; then
  if [ -n "$canonical_workspace" ] && [ "$canonical_workspace" != "$workspace" ]; then
    echo "antigravity-agent: canonical_workspace=$canonical_workspace launch_workspace=$workspace" >&2
  fi
  echo "antigravity-agent: workspace=$workspace project=$project_id model=${AGY_MODEL:-default} session=${resume_session:-new} timeout=$timeout log_file=${AGY_LOG_FILE:-default} run_log=$log_file" >&2
fi

# ponytail: snapshot every pid that exists before this run starts (space-
# separated, not the newline-separated `ls` default — a case-pattern
# membership test against a newline-joined string silently never matches),
# so we can find whatever's new afterward. A plain process-group kill isn't
# enough — `nohup cmd & disown` (or an agent's own detached-background
# tooling) fully escapes the group into its own session, which is exactly
# how a forgotten dev server survives the wrapper exiting.
done_model="${AGY_MODEL:-default}"
provider_name="antigravity"
runner_bin="$agy_bin"
provider_prompt_rules="Do not put deliverables in Antigravity scratch."
run_agent_runtime "$@"
