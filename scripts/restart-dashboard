#!/usr/bin/env sh
set -eu

compose_dir="${SUBAGENT_DOCKER_DIR:-$HOME/docker/agent-relay}"
service="${SUBAGENT_DOCKER_SERVICE:-subagent-dashboard}"
log_file="$compose_dir/restart.log"
lock_dir="$compose_dir/restart.lock"
script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")/.." && pwd -P)"

if [ -d "$lock_dir" ]; then
  lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || echo "")"
  if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
    printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ) restart already running (PID $lock_pid)" >> "$log_file"
    exit 0
  fi
  # Lock is stale: process died or directory was left behind
  rm -rf "$lock_dir" 2>/dev/null || true
fi

if ! mkdir "$lock_dir" 2>/dev/null; then
  printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ) restart lock acquisition failed" >> "$log_file"
  exit 0
fi
echo "$$" > "$lock_dir/pid"
trap 'rm -rf "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM

{
  printf '\n%s\n' "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) agent-relay dashboard restart ==="
  cd "$compose_dir"
  docker compose --project-directory "$repo_dir" stop "$service" || true
  docker compose --project-directory "$repo_dir" build "$service"
  docker compose --project-directory "$repo_dir" up -d --force-recreate "$service"
} >> "$log_file" 2>&1
