#!/usr/bin/env sh
set -eu

repo_dir="$(git rev-parse --show-toplevel)"
hook="$repo_dir/.git/hooks/post-commit"
restart_script="$repo_dir/scripts/restart-dashboard"

mkdir -p "$(dirname "$hook")"
cat > "$hook" <<HOOK
#!/usr/bin/env sh
set -u

repo_dir="$repo_dir"

if [ "\${AGENT_RELAY_DOCKER_AUTO_RESTART:-1}" = "1" ]; then
  ( "$restart_script" ) >/dev/null 2>&1 &
  echo "agent-relay dashboard restart queued"
fi

for remote in origin gitea; do
  if git -C "$repo_dir" remote get-url "\$remote" >/dev/null 2>&1; then
    if git -C "$repo_dir" push "\$remote" HEAD:main >/dev/null 2>&1; then
      echo "agent-relay pushed to \$remote"
    else
      echo "agent-relay push to \$remote failed" >&2
    fi
  fi
done
HOOK

chmod +x "$hook"
printf 'installed %s\n' "$hook"
