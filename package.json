    "type": "git",
    "url": "https://github.com/akashpandey/agent-relay.git"
  },
  "bugs": {
    "url": "https://github.com/akashpandey/agent-relay/issues"
  },
  "bin": {
    "relay": "./agent",
    "agent-relay": "./agent",
    "agent-relay-mcp": "./agent-relay-mcp",
    "opencode-agent": "./opencode-agent",
    "opencode-agent-fallback": "./opencode-agent-fallback",
    "antigravity-agent": "./antigravity-agent",
    "claude-agent": "./claude-agent",
    "codex-agent": "./codex-agent",
    "agent-doctor": "./agent-doctor",
    "agent-wait": "./agent-wait"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "agent",
    "relay",
    "agent-relay-mcp",
    "agent-dashboard",
    "agent-doctor",
    "agent-wait",
    "opencode-agent",
    "opencode-agent-fallback",
    "antigravity-agent",
    "claude-agent",
    "codex-agent",
    "install-skill",
    "scripts/",
    "dashboard/",
    "skills/",
    "docs/",
    "plugins/",
    ".claude-plugin/",
    ".agents/plugins/",
    "docker-compose.sample.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "coding-agents",
    "mcp",
    "orchestration",
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "relay",
    "delegation",
    "multi-agent"
  ],
  "scripts": {
    "sync:skills": "node scripts/sync-plugin-skill.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run sync:skills",
    "test": "node --test tests/*.mjs",
    "test:mcp": "node --test tests/test-mcp-server.mjs",
    "test:wrappers": "./tests/test-wrappers.sh",
    "test:package": "node tests/package-smoke.js",
    "doctor": "./agent-doctor",
    "dashboard": "./agent-dashboard start",
    "dashboard:dev": "npm --prefix dashboard run dev"
