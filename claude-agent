#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

workspace="$(pwd -P)"
canonical_workspace=""
if command -v node >/dev/null 2>&1; then
  canonical_workspace="$(node "$repo_dir/scripts/workspace-canonical.mjs" "$workspace" 2>/dev/null || true)"
fi
timeout_seconds="${CLAUDE_TIMEOUT:-7200}"
# ponytail: timeout_spec is the duration literal for `timeout`/RuntimeMaxSec;
# invalid or zero values drop both instead of corrupting the systemd property.
case "$timeout_seconds" in ''|*[!0-9]*) timeout_spec='' ;; *) timeout_spec="${timeout_seconds}s" ;; esac

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: claude-agent --models" >&2
    exit 2
  fi
  if command -v node >/dev/null 2>&1 && [ -f "$repo_dir/scripts/resolve-models.mjs" ]; then
    node "$repo_dir/scripts/resolve-models.mjs" claude
  else
    printf '%s\n' opus sonnet
  fi
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  claude-agent "task"
  printf '%s\n' "task" | claude-agent
  claude-agent --models

Environment:
  CLAUDE_MODEL           Model alias or full model ID.
  CLAUDE_FALLBACK_MODEL  Comma-separated fallback aliases or IDs.
  CLAUDE_EFFORT          Optional effort: low, medium, high, xhigh, or max.
  AGENT_RELAY_SESSION       Resume this provider's existing session ID.
  CLAUDE_TIMEOUT         Timeout in seconds. Default: 7200.
  CLAUDE_LOGS            Print wrapper banner to stderr. Default: 1.
  AGENT_RELAY_LOG_DIR       Where wrapper run logs are written. Default: ~/agent-relay/logs.

Examples:
  CLAUDE_MODEL='sonnet' claude-agent "Fix the bug"
  CLAUDE_MODEL='opus' CLAUDE_EFFORT='high' claude-agent "Review this repo"
  CLAUDE_MODEL='sonnet' claude-agent "Implement TASK.md"

Claude Code has no live model-list command. `claude-agent --models` prints
the available documented selectors: opus and sonnet.
EOF
  exit 0
fi

resume_session="${AGENT_RELAY_SESSION:-${SUBAGENT_SESSION:-}}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

log_flag="${CLAUDE_LOGS:-1}"
log_dir="${AGENT_RELAY_LOG_DIR:-${SUBAGENT_LOG_DIR:-$repo_dir/logs}}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-claude-$$.log"
unit="local-agent-claude-$$"
claude_bin="${AGENT_RELAY_CLAUDE_BIN:-${SUBAGENT_CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}}"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
done_provider="claude"
. "$repo_dir/scripts/finalize-run.sh"
. "$repo_dir/scripts/wrapper-lib.sh"

resolve_claude_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    latest|claude-latest)
      echo "sonnet"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

cd "$workspace"

if [ -n "${CLAUDE_MODEL:-}" ]; then
  resolved_claude_model="$(resolve_claude_model "$CLAUDE_MODEL")"
  if [ "$resolved_claude_model" != "$CLAUDE_MODEL" ]; then
    echo "claude-agent: resolved alias '$CLAUDE_MODEL' -> '$resolved_claude_model'" >&2
    CLAUDE_MODEL="$resolved_claude_model"
  fi
fi

set -- --print --verbose --output-format stream-json --dangerously-skip-permissions
if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- "$@" --continue
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- "$@" --resume "$resume_session"
fi
[ -z "${CLAUDE_MODEL:-}" ] || set -- "$@" --model "$CLAUDE_MODEL"
[ -z "${CLAUDE_FALLBACK_MODEL:-}" ] || set -- "$@" --fallback-model "$CLAUDE_FALLBACK_MODEL"
[ -z "${CLAUDE_EFFORT:-}" ] || set -- "$@" --effort "$CLAUDE_EFFORT"
set -- "$@" "$(agent_prompt "$workspace" "$user_prompt")"

if [ "$log_flag" = "1" ]; then
  if [ -n "$canonical_workspace" ] && [ "$canonical_workspace" != "$workspace" ]; then
    echo "claude-agent: canonical_workspace=$canonical_workspace launch_workspace=$workspace" >&2
  fi
  echo "claude-agent: workspace=$workspace model=${CLAUDE_MODEL:-default} effort=${CLAUDE_EFFORT:-default} fallback=${CLAUDE_FALLBACK_MODEL:-none} session=${resume_session:-new} timeout=${timeout_seconds}s run_log=$log_file" >&2
fi

done_model="${CLAUDE_MODEL:-default}"
provider_name="claude"
runner_bin="$claude_bin"
run_agent_runtime "$@"
