#!/usr/bin/env sh
set -eu

script_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"

workspace="$(pwd -P)"
canonical_workspace=""
if command -v node >/dev/null 2>&1; then
  canonical_workspace="$(node "$repo_dir/scripts/workspace-canonical.mjs" "$workspace" 2>/dev/null || true)"
fi
timeout_seconds="${CODEX_TIMEOUT:-7200}"

# Prevent hanging network commands from blocking subprocess cleanup
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export CURL_CONNECT_TIMEOUT="${CURL_CONNECT_TIMEOUT:-10}"

if [ "${1:-}" = "--models" ]; then
  if [ "$#" -ne 1 ]; then
    echo "Usage: codex-agent --models" >&2
    exit 2
  fi
  echo "codex-agent: Codex has no live model-list command; showing documented selectors." >&2
  printf '%s\n' gpt-5.6-sol gpt-5.6-terra gpt-5.6-luna
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage:
  codex-agent "task"
  printf '%s\n' "task" | codex-agent
  codex-agent --models

Environment:
  CODEX_MODEL      Model selector or family alias:
                   - 'latest' / 'sol' / 'gpt-sol': newest GPT-5.6 Sol
                   - 'terra' / 'gpt-terra': GPT-5.6 Terra
                   - 'luna' / 'gpt-luna': GPT-5.6 Luna
  CODEX_EFFORT     Optional effort: low, medium, high, xhigh, max, or ultra.
  CODEX_SANDBOX    Sandbox mode. Default: workspace-write, or danger-full-access
                   when this host cannot create Bubblewrap user namespaces.
  AGENT_RELAY_SESSION Resume this provider's existing session ID.
  CODEX_TIMEOUT    Timeout in seconds. Default: 7200.
  CODEX_LOGS       Print wrapper banner to stderr. Default: 1.
  AGENT_RELAY_LOG_DIR Where wrapper run logs are written. Default: ~/agent-relay/logs.

Examples:
  CODEX_MODEL='latest' codex-agent "Fix the bug"
  CODEX_MODEL='terra' CODEX_EFFORT='high' codex-agent "Review this repo"
  CODEX_MODEL='gpt-5.6-sol' CODEX_EFFORT='max' codex-agent "Implement TASK.md"

Codex has no live model-list command. `codex-agent --models` prints the
documented selectors: gpt-5.6-sol, gpt-5.6-terra, and gpt-5.6-luna.
EOF
  exit 0
fi

resume_session="${AGENT_RELAY_SESSION:-${SUBAGENT_SESSION:-}}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --continue|-c)
      resume_session="--last"
      shift
      ;;
    --resume|--session)
      resume_session="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  user_prompt="$*"
else
  user_prompt="$(cat)"
fi

export CI="${CI:-1}"
export npm_config_yes="${npm_config_yes:-true}"
export npm_config_fund="${npm_config_fund:-false}"
export npm_config_audit="${npm_config_audit:-false}"
export DEBIAN_FRONTEND="${DEBIAN_FRONTEND:-noninteractive}"
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"
export PAGER="${PAGER:-cat}"
export GIT_PAGER="${GIT_PAGER:-cat}"
export SYSTEMD_PAGER="${SYSTEMD_PAGER:-cat}"

prompt="You are running as a non-interactive coding agent.
Workspace: $workspace

Rules:
- Treat the workspace above as the project root.
- Write requested files under that workspace unless the prompt gives a different absolute path.
- Run all commands in non-interactive batch mode (e.g. use 'npx -y', avoid interactive stdin/prompts).
- After editing, summarize changed files and verification commands.
- Use outcome=done only when the requested task is complete and verification passed or was explicitly unnecessary.
- CRITICAL: Your absolute last turn MUST end with this exact JSON structure (no text or markdown after it):
\`\`\`json
{
  \"outcome\": \"done\",
  \"summary\": \"Brief explanation of what was done.\",
  \"changedFiles\": [\"path/to/file\"],
  \"verification\": [
    {
      \"command\": \"npm test\",
      \"status\": \"passed\",
      \"reason\": \"All tests passed\"
    }
  ],
  \"blockers\": [],
  \"incomplete\": [],
  \"nextSteps\": []
}
\`\`\`
outcome must be: done | partial | blocked | failed.
verification status must be: passed | failed | skipped.

Task:
$user_prompt"

log_flag="${CODEX_LOGS:-1}"
sandbox="${CODEX_SANDBOX:-workspace-write}"
codex_bin="${AGENT_RELAY_CODEX_BIN:-${SUBAGENT_CODEX_BIN:-$(command -v codex 2>/dev/null || echo "codex")}}"

# ponytail: Bubblewrap cannot start here when AppArmor denies unprivileged user
# namespaces. Keep the safe default where available; callers can still force a
# sandbox explicitly, and the host policy can be fixed later to remove fallback.
if [ -z "${CODEX_SANDBOX+x}" ] && ! unshare -Ur true >/dev/null 2>&1; then
  sandbox="danger-full-access"
  echo "codex-agent: workspace-write unavailable; using danger-full-access" >&2
fi
log_dir="${AGENT_RELAY_LOG_DIR:-${SUBAGENT_LOG_DIR:-$repo_dir/logs}}"
mkdir -p "$log_dir"
log_file="$log_dir/$(date +%Y%m%dT%H%M%S)-codex-$$.log"
unit="local-agent-codex-$$"
use_systemd=0
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  use_systemd=1
fi
tail_pid=""
watchdog_pid=""

stop_subagent() {
  [ -z "$watchdog_pid" ] || kill "$watchdog_pid" >/dev/null 2>&1 || true
  [ -z "$tail_pid" ] || kill "$tail_pid" >/dev/null 2>&1 || true
  if [ "$use_systemd" -eq 1 ]; then
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
  elif [ -n "${cmd_pid:-}" ] && command -v pkill >/dev/null 2>&1; then
    pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
    sleep 1
    pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
  fi
}
done_provider="codex"
done_model="${CODEX_MODEL:-default}"
. "$repo_dir/scripts/finalize-run.sh"

resolve_codex_model() {
  raw_model="${1:-}"
  [ -z "$raw_model" ] && return 0

  case "$(echo "$raw_model" | tr '[:upper:]' '[:lower:]')" in
    latest|sol|gpt-sol|openai/sol|gpt-5.6-sol)
      echo "gpt-5.6-sol"
      ;;
    terra|gpt-terra|gpt-5.6-terra)
      echo "gpt-5.6-terra"
      ;;
    luna|gpt-luna|gpt-5.6-luna)
      echo "gpt-5.6-luna"
      ;;
    *)
      echo "$raw_model"
      ;;
  esac
}

cd "$workspace"

if [ -n "${CODEX_MODEL:-}" ]; then
  resolved_codex_model="$(resolve_codex_model "$CODEX_MODEL")"
  if [ "$resolved_codex_model" != "$CODEX_MODEL" ]; then
    echo "codex-agent: resolved alias '$CODEX_MODEL' -> '$resolved_codex_model'" >&2
    CODEX_MODEL="$resolved_codex_model"
  fi
fi

set -- --ask-for-approval never exec --json --cd "$workspace" --sandbox "$sandbox" --skip-git-repo-check
if [ "$resume_session" = "--last" ] || [ "$resume_session" = "last" ]; then
  set -- "$@" resume --last
elif [ -n "$resume_session" ] && [ "$resume_session" != "new" ]; then
  set -- "$@" resume "$resume_session"
fi
[ -z "${CODEX_MODEL:-}" ] || set -- "$@" --model "$CODEX_MODEL"
[ -z "${CODEX_EFFORT:-}" ] || set -- "$@" -c "model_reasoning_effort=\"$CODEX_EFFORT\""
set -- "$@" "$prompt"

if [ "$log_flag" = "1" ]; then
  if [ -n "$canonical_workspace" ] && [ "$canonical_workspace" != "$workspace" ]; then
    echo "codex-agent: canonical_workspace=$canonical_workspace launch_workspace=$workspace" >&2
  fi
  echo "codex-agent: workspace=$workspace model=${CODEX_MODEL:-default} effort=${CODEX_EFFORT:-default} sandbox=$sandbox session=${resume_session:-new} timeout=${timeout_seconds}s run_log=$log_file" >&2
fi

# ponytail: a separate process group makes timeout cleanup cover ordinary children.
before_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
printf 'agent: provider=codex workspace=%s model=%s session=%s\nagent-unit: %s\nTask:\n%s\n\n---\n\n' \
  "$workspace" "${CODEX_MODEL:-default}" "${resume_session:-new}" "$done_unit" "$user_prompt" > "$log_file"

# Register run start in SQLite database immediately
mark_output_start
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" start "$(basename "$log_file")" "$$" "codex" "${CODEX_MODEL:-default}" "$workspace" "${resume_session:-new}" "$user_prompt" >/dev/null 2>&1 || true
fi

if [ "$use_systemd" -eq 1 ]; then
  systemd-run --user --pipe --working-directory="$workspace" --setenv=PATH="$PATH" --wait --collect --quiet --unit="$unit" --property=KillMode=control-group --property=RuntimeMaxSec="${timeout_seconds}s" "$codex_bin" "$@" >>"$log_file" 2>&1 &
elif [ "$timeout_seconds" -gt 0 ] 2>/dev/null && command -v timeout >/dev/null 2>&1; then
  setsid timeout --foreground "${timeout_seconds}s" "$codex_bin" "$@" >>"$log_file" 2>&1 &
else
  setsid "$codex_bin" "$@" >>"$log_file" 2>&1 &
fi
cmd_pid=$!
tail -f "$log_file" &
tail_pid=$!

# Background watchdog: reap hanging runtime if task completed but lingering event-loop handles prevent exit
(
  while kill -0 "$cmd_pid" 2>/dev/null; do
    sleep 2
    if grep -qE 'hook: Stop Completed' "$log_file" 2>/dev/null || \
       awk '/^---$/{f=1; next} f' "$log_file" 2>/dev/null | grep -qE '(\\"|")outcome(\\"|"):[[:space:]]*(\\"|")(done|partial|blocked|failed)'; then
      grace=6
      while [ "$grace" -gt 0 ] && kill -0 "$cmd_pid" 2>/dev/null; do
        sleep 1
        grace=$((grace - 1))
      done
      if kill -0 "$cmd_pid" 2>/dev/null; then
        touch "${log_file}.reaped"
        if [ "$use_systemd" -eq 1 ]; then
          systemctl --user stop "$unit" >/dev/null 2>&1 || true
        elif command -v pkill >/dev/null 2>&1; then
          pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
          sleep 1
          pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
        fi
      fi
      break
    fi
  done
) &
watchdog_pid=$!

set +e
wait "$cmd_pid"
status=$?
set -e

kill "$watchdog_pid" >/dev/null 2>&1 || true
wait "$watchdog_pid" 2>/dev/null || true
kill "$tail_pid" >/dev/null 2>&1 || true
wait "$tail_pid" 2>/dev/null || true

if [ -f "${log_file}.reaped" ]; then
  rm -f "${log_file}.reaped"
  if [ "$status" -ne 0 ]; then
    if [ "$log_flag" = "1" ]; then
      echo "codex-agent: process reaped after task completion (lingering event-loop handles)" >&2
    fi
    status=0
  fi
fi
if [ "$use_systemd" -eq 1 ]; then
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
elif command -v pkill >/dev/null 2>&1; then
  pkill -TERM -g "$cmd_pid" >/dev/null 2>&1 || true
  sleep 1
  pkill -KILL -g "$cmd_pid" >/dev/null 2>&1 || true
fi

# Clean up orphaned processes in the workspace (only in non-systemd fallback mode)
if [ "$use_systemd" -eq 0 ]; then
  workspace_real="$(cd "$workspace" && pwd -P)"
  after_pids="$(ls /proc 2>/dev/null | tr '\n' ' ')"
  new_pids=""
  for pid in $after_pids; do
    case " $before_pids " in
      *" $pid "*) ;;
      *) new_pids="$new_pids $pid" ;;
    esac
  done

  for sig in TERM KILL; do
    if [ "$sig" = "KILL" ]; then
      sleep 1
    fi
    for pid in $new_pids; do
      [ "$pid" = "$$" ] && continue
      pid_cmd="$([ -f "/proc/$pid/cmdline" ] && cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)"
      case "$pid_cmd" in
        *-subagent*|*systemd-run*|*claude*|*codex*|*opencode*|*antigravity*|*agy*)
          continue
          ;;
      esac
      pid_cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
      if [ -z "$pid_cwd" ]; then
        continue
      fi
      case "$pid_cwd" in
        "$workspace_real"|"$workspace_real"/*)
          kill "-$sig" "$pid" >/dev/null 2>&1 || true
          ;;
      esac
    done
  done
fi

# Write completion sentinel file (.done)
done_file="${log_file%.log}.done"
sess_id="$(grep -oE '"session_id":"[^"]+"' "$log_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || grep -iE '^session id:' "$log_file" 2>/dev/null | head -n 1 | awk '{print $3}' || echo "${resume_session:-new}")"
if [ -z "$sess_id" ]; then
  sess_id="$(grep -iE '^session id:' "$log_file" 2>/dev/null | head -n 1 | awk '{print $3}' || echo "${resume_session:-new}")"
fi
write_done "$status"

# Automatically ingest subagent session to claude-mem (non-blocking)
if [ -f "$done_file" ] && command -v bun >/dev/null 2>&1; then
  bun "$repo_dir/scripts/ingest-to-claude-mem.js" "$done_file" >/dev/null 2>&1 &
fi

# Register run completion in SQLite database
if command -v node >/dev/null 2>&1; then
  node "$repo_dir/scripts/subagent-tracker.js" complete "$(basename "$log_file")" "$status" "$sess_id" >/dev/null 2>&1 || true
fi

if [ "$log_flag" = "1" ]; then
  echo "codex-agent: finished status=$status ($([ "$status" -eq 0 ] && echo "completed" || echo "failed")) session=$sess_id" >&2
fi

exit "$status"
